# Supply-chain hardening — mirror of frontend/.npmrc (see that file for context).
# Skip packages younger than 7 days (60*24*7 = 10080 min) so fresh malicious
# versions usually get yanked before our installs would pick them up.
minimum-release-age=10080
minimum-release-age-exclude=

# pnpm 10 defaults — match frontend for consistency.
auto-install-peers=true
strict-peer-dependencies=false

# pnpm 11: disable the pre-run deps-status check that fails on unapproved
# build scripts (esbuild's via vitest). We've explicitly allowed esbuild in
# pnpm-workspace.yaml's onlyBuiltDependencies — this just stops pnpm from
# re-validating before every script invocation.
verify-deps-before-run=false

# pnpm 11 — skip pre-run integrity check + auto-purge node_modules
# without TTY. Mirrors frontend/.npmrc.
verify-deps-before-run=false
confirm-modules-purge=false
